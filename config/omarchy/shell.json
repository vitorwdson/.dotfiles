{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "NightLight",
            "Reminder",
            "ScreenRecording",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "settings": {
            "size": 14
          }
        },
        {
          "id": "omarchy.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.notifications-center",
          "type": "command",
          "text": "",
          "fontSize": 18,
          "interval": 2,
          "tooltip": "Notification center (right-click toggles DND)",
          "exec": "printf '{\"text\":\"\\uF0F3\",\"class\":\"%s\"}' $([ \"$(swaync-client -D)\" = true ] && echo active || echo inactive)",
          "onClick": "swaync-client -t -sw",
          "onRightClick": "swaync-client -d"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "version": 1
}
